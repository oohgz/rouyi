<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.manage.mapper.CourseMapper">
    
    <resultMap type="com.ruoyi.manage.domain.Course" id="CourseResult">
        <result property="id"    column="id"    />
        <result property="courseCode"    column="course_code"    />
        <result property="courseName"    column="course_name"    />
        <result property="college"    column="college"    />
        <result property="teacherId"    column="teacher_id"    />
        <result property="teacherName"    column="teacher_name"    />
        <result property="maxStudents"    column="max_students"    />
        <result property="status"    column="status"    />
    </resultMap>

    <sql id="selectCourseVo">
        select id, course_code, course_name, college, teacher_id, max_students, status from tb_course
    </sql>

    <select id="selectCourseList" parameterType="com.ruoyi.manage.domain.Course" resultMap="CourseResult">
        select
        c.id,
        c.course_code,
        c.course_name,
        c.college,
        c.teacher_id,
        t.teacher_name,
        c.max_students,
        c.status
        from tb_course c
        inner join tb_teacher t on c.teacher_id = t.id
        <where>
            <if test="courseCode != null  and courseCode != ''"> and c.course_code = #{courseCode}</if>
            <if test="courseName != null  and courseName != ''"> and c.course_name like concat('%', #{courseName}, '%')</if>
            <if test="college != null  and college != ''"> and c.college = #{college}</if>
            <if test="teacherId != null "> and c.teacher_id = #{teacherId}</if>
            <if test="maxStudents != null "> and c.max_students = #{maxStudents}</if>
            <if test="status != null "> and c.status = #{status}</if>
            <if test="teacherName != null and teacherName != ''">
                and t.teacher_name like concat('%', #{teacherName}, '%')
            </if>
        </where>
    </select>

    <select id="selectCourseById" parameterType="Long" resultMap="CourseResult">
        select
        c.id,
        c.course_code,
        c.course_name,
        c.college,
        c.teacher_id,
        t.teacher_name,
        c.max_students,
        c.status
        from tb_course c
        inner join tb_teacher t on c.teacher_id = t.id
        where c.id = #{id}
    </select>

    <insert id="insertCourse" parameterType="com.ruoyi.manage.domain.Course" useGeneratedKeys="true" keyProperty="id">
        insert into tb_course
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="courseCode != null and courseCode != ''">course_code,</if>
            <if test="courseName != null and courseName != ''">course_name,</if>
            <if test="college != null and college != ''">college,</if>
            <if test="teacherId != null">teacher_id,</if>
            <if test="maxStudents != null">max_students,</if>
            <if test="status != null">status,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="courseCode != null and courseCode != ''">#{courseCode},</if>
            <if test="courseName != null and courseName != ''">#{courseName},</if>
            <if test="college != null and college != ''">#{college},</if>
            <if test="teacherId != null">#{teacherId},</if>
            <if test="maxStudents != null">#{maxStudents},</if>
            <if test="status != null">#{status},</if>
         </trim>
    </insert>

    <update id="updateCourse" parameterType="com.ruoyi.manage.domain.Course">
        update tb_course
        <trim prefix="SET" suffixOverrides=",">
            <if test="courseCode != null and courseCode != ''">course_code = #{courseCode},</if>
            <if test="courseName != null and courseName != ''">course_name = #{courseName},</if>
            <if test="college != null and college != ''">college = #{college},</if>
            <if test="teacherId != null">teacher_id = #{teacherId},</if>
            <if test="maxStudents != null">max_students = #{maxStudents},</if>
            <if test="status != null">status = #{status},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteCourseById" parameterType="Long">
        delete from tb_course where id = #{id}
    </delete>

    <delete id="deleteCourseByIds" parameterType="String">
        delete from tb_course where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>
