<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.manage.mapper.StudentMapper">

    <resultMap type="com.ruoyi.manage.domain.Student" id="StudentResult">
        <result property="id"    column="id"    />
        <result property="studentNo"    column="student_no"    />
        <result property="studentName"    column="student_name"    />
        <result property="userId"    column="user_id"    />
    </resultMap>

    <sql id="selectStudentVo">
        select id, student_no, student_name, user_id from tb_student <!-- 统一表名 tb_student -->
    </sql>

    <!-- 新增：根据学生ID列表查询详情 -->
    <select id="selectStudentsByIds" resultType="com.ruoyi.manage.domain.Student">
        SELECT
        id, student_no AS studentNo, student_name AS studentName
        -- 按需添加其他字段（如性别、班级等），至少保留id和studentName（下拉框显示用）
        FROM tb_student
        WHERE id IN
        <foreach collection="studentIds" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </select>

    <!-- 仅保留一个 selectStudentByUserId 方法，使用 resultMap 映射 -->
    <select id="selectStudentByUserId" parameterType="Long" resultMap="StudentResult">
        <include refid="selectStudentVo"/>
        where user_id = #{userId}
    </select>

    <select id="selectStudentList" parameterType="com.ruoyi.manage.domain.Student" resultMap="StudentResult">
        <include refid="selectStudentVo"/>
        <where>
            <if test="studentNo != null  and studentNo != ''"> and student_no = #{studentNo}</if>
            <if test="studentName != null  and studentName != ''"> and student_name like concat('%', #{studentName}, '%')</if>
            <if test="userId != null"> and user_id = #{userId}</if>
        </where>
    </select>

    <select id="selectStudentById" parameterType="Long" resultMap="StudentResult">
        <include refid="selectStudentVo"/>
        where id = #{id}
    </select>

    <insert id="insertStudent" parameterType="com.ruoyi.manage.domain.Student" useGeneratedKeys="true" keyProperty="id">
        insert into tb_student
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="studentNo != null and studentNo != ''">student_no,</if>
            <if test="studentName != null and studentName != ''">student_name,</if>
            <if test="userId != null">user_id,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="studentNo != null and studentNo != ''">#{studentNo},</if>
            <if test="studentName != null and studentName != ''">#{studentName},</if>
            <if test="userId != null">#{userId},</if>
        </trim>
    </insert>

    <update id="updateStudent" parameterType="com.ruoyi.manage.domain.Student">
        update tb_student
        <trim prefix="SET" suffixOverrides=",">
            <if test="studentNo != null and studentNo != ''">student_no = #{studentNo},</if>
            <if test="studentName != null and studentName != ''">student_name = #{studentName},</if>
            <if test="userId != null">user_id = #{userId},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteStudentById" parameterType="Long">
        delete from tb_student where id = #{id}
    </delete>

    <delete id="deleteStudentByIds" parameterType="String">
        delete from tb_student where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>